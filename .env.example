# Contact form email (Nodemailer). Copy to .env.local and fill in.
# For Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
# Optional (defaults shown)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# Inbox that receives inquiries (defaults to CONTACT_EMAIL in config/constant.ts)
# CONTACT_TO_EMAIL=
